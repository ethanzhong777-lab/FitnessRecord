page {
  min-height: 100%;
  background: #0b0d0c;
  color: #f4f7f5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #2a2f2c;
  border-radius: 32rpx;
  background: #181b19;
}

